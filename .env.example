# Local Compose defaults. Keep these demo credentials aligned with
# docker/init/00-users-and-dbs.sql if you change them.
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_HOST_PORT=3307

# Java services connect to MySQL over the Compose network.
DB_HOST=mysql
DB_PORT=3306
DB_POOL_SIZE=5

# Published and in-container gRPC ports for each Java service.
AUTH_HOST_PORT=50051
AUTH_GRPC_PORT=50051
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password

CATALOG_HOST_PORT=50052
CATALOG_GRPC_PORT=50052
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_password

ENROLLMENT_HOST_PORT=50053
ENROLLMENT_GRPC_PORT=50053
ENROLLMENT_DB_USER=enroll_user
ENROLLMENT_DB_PASSWORD=enrollment_password

GRADES_VIEW_HOST_PORT=50054
GRADES_VIEW_GRPC_PORT=50054
GRADES_VIEW_DB_USER=grades_view_user
GRADES_VIEW_DB_PASSWORD=grades_view_password

GRADES_UPLOAD_HOST_PORT=50055
GRADES_UPLOAD_GRPC_PORT=50055
GRADES_UPLOAD_DB_USER=grades_upload_user
GRADES_UPLOAD_DB_PASSWORD=grades_upload_password

# Key paths inside the containers. Only auth-node receives the private key.
JWT_PRIVATE_KEY_PATH=/run/keys/private.pem
JWT_PUBLIC_KEY_PATH=/run/keys/public.pem

# Web frontend settings.
VIEW_HOST_PORT=8080
GRPC_TIMEOUT_MS=2000
SESSION_COOKIE_NAME=enroll_token
USE_MOCKS=false
MOCK_SERVICES=
DEAD_NODES=